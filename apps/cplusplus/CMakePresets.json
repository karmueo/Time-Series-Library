{
  "version": 3,
  "configurePresets": [
    {
      "name": "linux-release",
      "hidden": false,
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "USE_GPU": "ON",
        "BUILD_TESTS": "ON"
      }
    },
    {
      "name": "linux-debug",
      "hidden": false,
      "binaryDir": "${sourceDir}/build-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "USE_GPU": "OFF",
        "BUILD_TESTS": "ON"
      }
    },
    {
      "name": "linux-release-cpu",
      "hidden": false,
      "binaryDir": "${sourceDir}/build-cpu",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "USE_GPU": "OFF",
        "BUILD_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "linux-release",
      "configuration": "Release"
    },
    {
      "name": "debug",
      "configurePreset": "linux-debug",
      "configuration": "Debug"
    },
    {
      "name": "cpu",
      "configurePreset": "linux-release-cpu",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "all",
      "configurePreset": "linux-release",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
